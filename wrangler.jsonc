{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glass-sky-oasis",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_OWNER": "hexx1234",
    "GITHUB_REPO": "GlassSkyOasis",
    "GITHUB_BRANCH": "main"
  }
}
